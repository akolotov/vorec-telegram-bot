# Telegram bot token obtained from @BotFather.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Unique Docker Compose project name for this deployment.
COMPOSE_PROJECT_NAME=your-bot-deployment

# Defaults to the published latest image and always pulls before startup.
# For a local build, set VOREC_BOT_IMAGE=vorec-telegram-bot:local and
# VOREC_BOT_PULL_POLICY=never.
# VOREC_BOT_IMAGE=ghcr.io/akolotov/vorec-telegram-bot:latest
# VOREC_BOT_PULL_POLICY=always

# The public webhook hostname and route handled by your ingress.
WEBHOOK_PUBLIC_BASE_URL=https://your-webhook-host.example
WEBHOOK_DOCKER_ALIAS=your-bot-alias
WEBHOOK_PATH=/hooks/your-bot-alias/telegram/webhook
# Generate a random 1-256 character value using A-Z, a-z, 0-9, _ or -.
WEBHOOK_SECRET_TOKEN=replace_with_a_long_random_webhook_secret
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_PORT=8080

# Comma-separated Telegram user IDs allowed to use the bot.
ALLOWED_USER_IDS=123456789,987654321

# GigaAM-compatible OpenAI API endpoint. Docker Desktop containers reach a host service through
# host.docker.internal. Use a long random token.
GIGAAM_URL=http://host.docker.internal:18000/v1
GIGAAM_API_KEY=replace_with_a_long_random_token
# GIGAAM_MODEL=whisper-1
# GIGAAM_MODEL_PATH=/path/to/gigaam-model
# GIGAAM_PORT=18000
# GIGAAM_VARIANT=int8
# GIGAAM_TMUX_SESSION=vorec-gigaam
# An optional path to the GigaAM manager script for a shared deployment.
# GIGAAM_MANAGER_SCRIPT=/path/to/manage-gigaam.sh

# OpenAI-compatible endpoint used for the primary transcription and merge. Docker Desktop
# containers reach a locally running provider through host.docker.internal.
# Uses bundled ffmpeg by default. Set to afconvert to use the macOS converter instead.
# AUDIO_CONVERTER=ffmpeg
INFERENCE_API_URL=http://host.docker.internal:8111/v1
INFERENCE_API_KEY=your_inference_api_key
# PRIMARY_TRANSCRIPTION_MODEL=whisper-large-v3-turbo-asr-fp16
# MERGE_MODEL=gemma-4-26b-a4b-it-4bit
# Enable only when the Whisper and GigaAM providers have independent capacity. The scheduler is
# local to one bot process and does not coordinate other deployments sharing either provider.
# SMART_TRANSCRIPTION_SCHEDULING=false
